{
  "name": "@zhengyongjie16/pi-subagents",
  "version": "0.5.0",
  "description": "Session-scoped subagents for Pi with templates, waits, steering, and a live overlay.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "subagents",
    "multi-agent",
    "coding-agent"
  ],
  "scripts": {
    "test": "bun test ./tests --timeout 60000",
    "test:node": "node --test ./tests/runtime.test.ts"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "latest",
    "@earendil-works/pi-coding-agent": "latest",
    "@earendil-works/pi-tui": "latest",
    "typebox": "latest"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=1.1.0",
    "@earendil-works/pi-coding-agent": ">=1.1.0",
    "@earendil-works/pi-tui": ">=1.1.0",
    "typebox": "*"
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "files": [
    "src/index.ts",
    "src/core.ts",
    "src/runtime.ts",
    "src/peek.ts",
    "src/widget.ts",
    "src/color.ts",
    "README.md",
    "LICENSE"
  ]
}